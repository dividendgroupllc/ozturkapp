# ozturkapp deploy sozlamalari
#
# Serverda shu faylni deploy/deploy.env nomi bilan nusxa olib to'ldiring:
#   cp deploy/deploy.env.example deploy/deploy.env
#   chmod 600 deploy/deploy.env
#
# deploy.env .gitignore da — git reset --hard uni o'chirmaydi.
#
# MUHIM: bu fayl bash tomonidan source qilinadi. Qiymatlarni doim qo'shtirnoq
# ichida yozing, aks holda probelli qiymatlar xatoga olib keladi.

# --- Majburiy -----------------------------------------------------------------

# Bench papkasining to'liq yo'li
BENCH_PATH="/home/frappe/frappe-bench"

# ozturkapp o'rnatilgan saytlar. Bir nechtasi bo'lsa probel bilan ajrating:
#   SITES="ozturk.erpcontrol.uz boshqa.sayt.uz"
SITES="ozturk.erpcontrol.uz"

# GitHub webhook uchun maxfiy kalit. Xuddi shu qiymatni GitHub repo
# Settings > Webhooks > Secret maydoniga kiritasiz. Yangi kalit yaratish:
#   openssl rand -hex 32
WEBHOOK_SECRET=""

# --- Ixtiyoriy (odatda o'zgartirish shart emas) --------------------------------

APP_NAME="ozturkapp"
BRANCH="main"

# bench buyrug'i PATH da bo'lmasa to'liq yo'lni yozing, masalan /usr/local/bin/bench
BENCH_BIN="bench"

# Minifikatsiya qilingan assetlar uchun: "--app ozturkapp --production"
BUILD_ARGS="--app ozturkapp"

# 1 = migrate dan keyin gunicorn/worker'lar qayta yuklanadi
DO_RESTART="1"
# `bench restart` ishlamasa quyidagini oching:
# RESTART_CMD="sudo supervisorctl restart frappe:"

# Webhook serveri qaysi manzilda tinglaydi.
# nginx orqali HTTPS bilan proxy qilsangiz 127.0.0.1 qoldiring,
# to'g'ridan-to'g'ri portga ulanadigan bo'lsangiz 0.0.0.0 qiling.
WEBHOOK_BIND="127.0.0.1"
WEBHOOK_PORT="9987"
WEBHOOK_PATH="/hook"

# Deploy jurnali
# LOG_FILE="/home/frappe/frappe-bench/logs/deploy-ozturkapp.log"
